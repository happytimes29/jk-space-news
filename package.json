{
  "name": "jk-space-news",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:local": "next build --webpack",
    "archive:prune": "node scripts/prune-news-content.mjs --apply",
    "archive:prune:dry": "node scripts/prune-news-content.mjs",
    "verify:content": "node scripts/validate-news-content.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build:local",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit": "lhci autorun"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.6.8",
    "cmdk": "^1.0.4",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.3",
    "lucide-react": "^0.511.0",
    "mdast-util-from-markdown": "2.0.3",
    "next": "^16.2.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/rss": "^0.0.32",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.3.2",
    "jsdom": "^30.1.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
